# Copy this file to .env and fill in your own values.
# .env is gitignored; never commit real keys.

# Required: Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing (see every LLM call at https://smith.langchain.com)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=invest-agents
